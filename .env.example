# --- LLM provider selection ---
# Which provider to use: openai or anthropic (both expect OpenAI- or Anthropic-compatible HTTP APIs)
LLM_PROVIDER=openai

# --- OpenAI (or OpenAI-compatible) endpoint ---
# Base URL of the API, e.g. https://api.openai.com/v1 for OpenAI,
# or your gateway/proxy base URL for a compatible server.
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (or Anthropic-compatible) endpoint ---
# Base URL of the API, e.g. https://api.anthropic.com for Anthropic,
# or your gateway/proxy base URL for a compatible server.
ANTHROPIC_API_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Summarizer limits ---
# Max stored summary versions per (URL + length) pair. Oldest is evicted past this.
MAX_SUMMARIES_PER_URL_LENGTH=5

# --- Backend (local dev) ---
DATABASE_PATH=backend/data/summaries.db
HOST=127.0.0.1
PORT=8000

# --- Production (docker compose) ---
# Host-side port for the web UI (nginx). Open http://localhost:8080 after `docker compose up`.
FRONTEND_PORT=8080
# NOTE: under compose, HOST/PORT/DATABASE_PATH are overridden inside the backend
# container (0.0.0.0:8000, SQLite on the yt-data volume), so you don't need to
# change them for prod. The LLM_* and MAX_SUMMARIES_* values above apply as-is.
