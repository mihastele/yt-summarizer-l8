# --- LLM provider selection ---
# Which provider to use: openai or anthropic (both expect OpenAI- or Anthropic-compatible HTTP APIs)
LLM_PROVIDER=openai

# --- OpenAI (or OpenAI-compatible) endpoint ---
# Base URL of the API, e.g. https://api.openai.com/v1 for OpenAI,
# or your gateway/proxy base URL for a compatible server.
#
# Local Ollama recipe (LLM_PROVIDER=openai):
#   1. Ollama must listen on all interfaces, not just localhost:
#      OLLAMA_HOST=0.0.0.0 ollama serve   (then restart Ollama)
#   2. Pull a model:  ollama pull gemma3:12b
#   3. Point the backend at it (depends on how you run the backend):
#        docker compose:  OPENAI_API_URL=http://host.docker.internal:11434/v1
#        local dev:       OPENAI_API_URL=http://localhost:11434/v1
#      (Inside a container, localhost means the container itself — that's why
#      the compose setup maps host.docker.internal to your machine.)
#   4. Leave OPENAI_API_KEY empty — Ollama needs no key.
#   5. Set OPENAI_MODEL to exactly what `ollama list` shows.
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (or Anthropic-compatible) endpoint ---
# Base URL of the API, e.g. https://api.anthropic.com for Anthropic,
# or your gateway/proxy base URL for a compatible server.
ANTHROPIC_API_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Summarizer limits ---
# Max stored summary versions per (URL + length) pair. Oldest is evicted past this.
MAX_SUMMARIES_PER_URL_LENGTH=5

# --- Admin user (in-memory, no database table) ---
# The single admin account. Only the admin can delete summaries (enforced by
# the backend on DELETE /api/summaries/{id}) and only the admin can search,
# filter, and browse beyond the 5 most recent summaries. Guests can summarize
# and view, but never delete.
# CHANGE THE PASSWORD before exposing the app to anyone else.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Backend (local dev) ---
DATABASE_PATH=backend/data/summaries.db
HOST=127.0.0.1
PORT=8000

# --- Production (docker compose) ---
# Host-side port for the web UI (nginx). Open http://localhost:8080 after `docker compose up`.
FRONTEND_PORT=8080
# Host-side port for direct backend access (loopback only). Change this if 8000
# is taken on your machine — the container itself always listens on 8000.
BACKEND_PORT=8000
# NOTE: under compose, HOST/PORT/DATABASE_PATH are overridden inside the backend
# container (0.0.0.0:8000, SQLite on the yt-data volume), so you don't need to
# change them for prod. The LLM_* and MAX_SUMMARIES_* values above apply as-is.
